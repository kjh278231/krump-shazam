{
  "manifest_version": 3,
  "name": "Krump Track Finder",
  "version": "0.1.0",
  "description": "Captures the current tab's audio and finds the track in the local library.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Krump Track Finder" }
}
