+	/**
+	 * Hough-style alignment over all hits: searches the line deltaT = slope * queryTime + offset
+	 * that puts the most hits within a narrow band. Unlike the first/last part heuristic this is
+	 * not thrown off by off-alignment hits from repeated loops or noise at the clip edges.
+	 * @param hits Hits for one reference, sorted by query time.
+	 * @return {slope, offset, frequencyFactor}
+	 */
+	private float[] robustAlignment(List<PanakoMatch> hits) {
+		int n = hits.size();
+		float[] q = new float[n];
+		float[] d = new float[n];
+		for(int i = 0 ; i < n ; i++) {
+			q[i] = hits.get(i).queryTime;
+			d[i] = hits.get(i).deltaT();
+		}
+		float span = Math.max(1, q[n-1] - q[0]);
+		float maxChange = Config.getFloat(Key.PANAKO_ROBUST_MAX_SPEED_CHANGE);
+		float minSlope = 1 - 1 / (1 - maxChange);
+		float maxSlope = 1 - 1 / (1 + maxChange);
+		float threshold = Config.getFloat(Key.PANAKO_QUERY_RANGE);
+
+		//coarse search with a wide band, slope 0 (no speed change) always included
+		float coarseWindow = 8;
+		float coarseStep = coarseWindow / 2 / span;
+		float bestSlope = 0;
+		float[] best = densestBand(q, d, 0, coarseWindow);
+		for(float s = minSlope ; s <= maxSlope ; s += coarseStep) {
+			float[] band = densestBand(q, d, s, coarseWindow);
+			if(band[0] > best[0]) {
+				best = band;
+				bestSlope = s;
+			}
+		}
+
+		//fine search around the coarse optimum with the final match tolerance
+		float fineWindow = 2 * threshold;
+		float fineStep = 0.5f / span;
+		float center = bestSlope;
+		best = densestBand(q, d, center, fineWindow);
+		for(float s = center - coarseStep ; s <= center + coarseStep ; s += fineStep) {
+			float[] band = densestBand(q, d, s, fineWindow);
+			if(band[0] > best[0]) {
+				best = band;
+				bestSlope = s;
+			}
+		}
+		float offset = best[1];
+
+		//frequency factor: median over the inliers
+		List<Float> ratios = new ArrayList<>();
+		for(int i = 0 ; i < n ; i++) {
+			if(Math.abs(d[i] - (bestSlope * q[i] + offset)) <= threshold) {
+				PanakoMatch hit = hits.get(i);
+				ratios.add(binToHz(hit.matchF1) / binToHz(hit.queryF1));
+			}
+		}
+		Collections.sort(ratios);
+		float frequencyFactor = ratios.isEmpty() ? 1 : ratios.get(ratios.size() / 2);
+
+		return new float[] {bestSlope, offset, frequencyFactor};
+	}
+
+	/**
+	 * @return {number of hits, band center} of the densest band of the given width
+	 * of residuals deltaT - slope * queryTime.
+	 */
+	private static float[] densestBand(float[] q, float[] d, float slope, float window) {
+		int n = q.length;
+		float[] r = new float[n];
+		for(int i = 0 ; i < n ; i++)
+			r[i] = d[i] - slope * q[i];
+		java.util.Arrays.sort(r);
+		int bestCount = 0;
+		float bestCenter = 0;
+		int start = 0;
+		for(int end = 0 ; end < n ; end++) {
+			while(r[end] - r[start] > window)
+				start++;
+			int count = end - start + 1;
+			if(count > bestCount) {
+				bestCount = count;
+				bestCenter = (r[start] + r[end]) / 2;
+			}
+		}
+		return new float[] {bestCount, bestCenter};
+	}
